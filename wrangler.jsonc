{
  // PartyServer deployment: a plain Cloudflare Worker + Durable Object
  // in our own account, deployed with `wrangler deploy`.
  "name": "mahjong",
  "main": "party/server.ts",
  "compatibility_date": "2025-04-01",
  // Serve the built client (vite build -> dist) from the same origin;
  // non-file requests fall through to the Worker (party routes).
  "assets": {
    "directory": "dist"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Mahjong",
        "class_name": "Mahjong"
      },
      {
        "name": "Registry",
        "class_name": "RoomRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Mahjong"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RoomRegistry"]
    }
  ],
  // Workers Previews (per-branch deployments from Workers Builds).
  // Each Preview automatically gets an isolated Durable Object
  // namespace and storage; the binding is mirrored here because the
  // router resolves the namespace from env, and a binding that is not
  // declared for Previews does not exist in a Preview.
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "Mahjong",
          "class_name": "Mahjong"
        },
        {
          "name": "Registry",
          "class_name": "RoomRegistry"
        }
      ]
    }
  }
}
