{
  "dependencies": {
    "partyserver": "^0.5.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wrangler": "^4.157.0"
  },
  "name": "mahjong",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "deploy": "wrangler deploy",
    "dev": "vite",
    "dev:party": "wrangler dev",
    "test:incarnation": "esbuild party/server.ts --bundle --format=esm --platform=node --alias:cloudflare:workers=./tests/stub-cloudflare-workers.mjs --outfile=tests/.build/server.mjs && node tests/incarnation.test.mjs",
    "test:restart": "node tests/restart-smoke.mjs",
    "test:diag": "esbuild party/server.ts --bundle --format=esm --platform=node --alias:cloudflare:workers=./tests/stub-cloudflare-workers.mjs --outfile=tests/.build/server.mjs && node tests/diag.test.mjs"
  },
  "type": "module",
  "version": "0.1.0"
}
